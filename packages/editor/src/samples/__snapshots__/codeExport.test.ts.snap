  {
    "content": "import './CodeCard.css'

const span = (className, text) => {
  const element = document.createElement('span')
  element.setAttribute('class', className)
  element.append(text)
  return element
}

export const createCodeCard = () => {
  const element0 = document.createElement('div')
  element0.setAttribute('class', 'code-card')
  const element1 = document.createElement('h2')
  element1.setAttribute('class', 'heading')
  element1.append('Export as code')
  element0.append(element1)
  const element2 = document.createElement('p')
  element2.setAttribute('class', 'body')
  element2.append('This card is an auto-layout frame, so HTML, Vue, React and JavaScript get flex boxes.')
  element0.append(element2)
  const element3 = document.createElement('div')
  element3.setAttribute('class', 'actions')
  const element4 = document.createElement('div')
  element4.setAttribute('class', 'copy-button')
  const element5 = document.createElement('p')
  element5.setAttribute('class', 'copy-label')
  element5.append('Copy')
  element4.append(element5)
  element3.append(element4)
  const element6 = document.createElement('div')
  element6.setAttribute('class', 'download-button')
  const element7 = document.createElement('p')
  element7.setAttribute('class', 'download-label')
  element7.append('Download')
  element6.append(element7)
  element3.append(element6)
  element0.append(element3)
  return element0
}
",
    "path": "createCodeCard.js",
  },
