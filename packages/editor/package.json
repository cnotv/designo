{
  "name": "@designo/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Designo editor: a Vue 3 app that draws Designo files on a canvas.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "start": "node server/productionServer.ts"
  },
  "dependencies": {
    "@designo/core": "workspace:*",
    "@designo/exporter": "workspace:*",
    "@designo/storage": "workspace:*",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "sirv": "^3.0.2",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.8",
    "vue-tsc": "^3.3.14"
  }
}
