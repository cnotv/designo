# Copy to .env next to docker-compose.yml.

# Where Designo is published on the host. 127.0.0.1 keeps it reachable only from this machine,
# for a reverse proxy on the same host.
DESIGNO_PORT=3020
DESIGNO_BIND=127.0.0.1

# Only for docker-compose.caddy.yml, on a server with no reverse proxy of its own.
DESIGNO_DOMAIN=designo.example.com
DESIGNO_USER=me
# Make the hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: they stop Docker Compose reading the $ signs in the hash as variables.
DESIGNO_PASSWORD_HASH='$2a$14$replace-with-your-hash'
