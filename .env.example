# Copy to .env next to docker-compose.yml.

# Where Designo is published on the host. 127.0.0.1 keeps it reachable only from this machine,
# for a reverse proxy on the same host.
DESIGNO_PORT=3020
DESIGNO_BIND=127.0.0.1

# Sign in with Google, off unless DESIGNO_AUTH=google. See documentation/docs/guides/self-hosting.md.
# DESIGNO_AUTH=google
# DESIGNO_GOOGLE_CLIENT_ID=
# DESIGNO_GOOGLE_CLIENT_SECRET=
# DESIGNO_PUBLIC_URL=https://designo.example.com
# DESIGNO_SESSION_SECRET=
# DESIGNO_ADMIN_EMAILS=you@example.com
# DESIGNO_AUTO_APPROVE_EMAILS=
# DESIGNO_AUTO_APPROVE_DOMAINS=
